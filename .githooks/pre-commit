#!/bin/sh
# Pengaman repo public: tolak commit yang membawa data rahasia (NPWP/NITKU pelanggan).
# Aktif lewat: git config core.hooksPath .githooks

# 1. File data tidak boleh ikut (contoh invoice, XML, data master).
data_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -iE '(^|/)(contoh|data)/|\.(pdf|xml|csv|xlsx|xls)$')
if [ -n "$data_files" ]; then
  echo "Commit DITOLAK: file data tidak boleh masuk repo public:" >&2
  echo "$data_files" >&2
  exit 1
fi

# 2. Angka mirip NPWP/NITKU: 15 digit atau lebih, atau format bertitik xx.xxx.xxx.x-xxx.xxx.
if git diff --cached -U0 --diff-filter=ACMR -- . ':(exclude)vendor' ':(exclude)package-lock.json' \
  | grep -E '^\+' | grep -vE '^\+\+\+ ' \
  | grep -qE '(^|[^0-9])[0-9]{15,}([^0-9]|$)|[0-9]{2}\.[0-9]{3}\.[0-9]{3}\.[0-9]-[0-9]{3}\.[0-9]{3}'; then
  echo "Commit DITOLAK: ada angka mirip NPWP di perubahan. Data seperti itu hanya boleh di repo private." >&2
  exit 1
fi
